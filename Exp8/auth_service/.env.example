# CampusConnect Auth Service — Environment Variables
# ====================================================
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file to version control.
#
# Add .env to your .gitignore:
#   echo ".env" >> .gitignore

# ── Required ───────────────────────────────────────────────────────────────
# A strong, random secret used to sign JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Minimum recommended length: 32 hex characters (256 bits).
JWT_SECRET=REPLACE_WITH_YOUR_OWN_STRONG_RANDOM_SECRET_DO_NOT_USE_IN_PRODUCTION

# ── Optional (defaults shown) ──────────────────────────────────────────────
# Number of hours before a JWT token expires.
JWT_EXPIRY_HOURS=2

# Flask server port (default: 5050 to avoid conflicts with React on 5173,
# JSON Server on 3000, and Spring Boot on 8080).
FLASK_PORT=5050

# Set to "true" to enable Flask debug / hot-reload mode.
# NEVER use debug=true in production.
FLASK_DEBUG=false
